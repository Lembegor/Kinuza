{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kinuza",
  "version": "../package.json",
  "identifier": "com.lembegor.kinuza",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:mpv && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kinuza",
        "width": 1400,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-blink-features=AudioVideoTracks --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* https://api.themoviedb.org https://graphql.anilist.co",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/bin/mpv/mpv.exe": "mpv/mpv.exe",
      "resources/bin/mpv/d3dcompiler_43.dll": "mpv/d3dcompiler_43.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Kinuza",
    "longDescription": "Kinuza - a media library and torrent streaming player",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNEMwMzNBQjZBOEY3NUMKUldSYzk2aTJPZ05NUFBKcndNQS9NS3dRdGRFRG5lSU50N1RURldzektTbnA0SnpoOXQzeFVnNmkK",
      "endpoints": [
        "https://github.com/Lembegor/Kinuza/releases/latest/download/latest.json",
        "https://github.com/Lembegor/kinuza-updates/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
