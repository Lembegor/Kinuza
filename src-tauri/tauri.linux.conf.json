{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kinuza",
        "width": 1400,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "resources": [],
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav", "libayatana-appindicator3-1"],
        "recommends": ["gstreamer1.0-plugins-bad", "mpv"]
      },
      "rpm": {
        "depends": ["gstreamer1-plugins-good", "libayatana-appindicator-gtk3"],
        "recommends": ["gstreamer1-plugin-libav", "gstreamer1-plugins-bad-free", "mpv"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
